#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* ZMK 側で 10 が定義済みなので警告回避のため一旦 undef */

#undef ZMK_POINTING_DEFAULT_SCRL_VAL

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

/*
 * zmk-config-roBa のキーマップを moNa2 へ移植したもの。
 * moNa2 は roBa と比べて 2 行目の左内側キー (roBa では Cmd+-) が 1 つ無いため、
 * 各レイヤーからその位置 (roBa の index 15) を除いている。
 * それ以外のキー位置は roBa と同じ。
 *
 * macOS 前提 (LG = Command、LA = Option)。日本語入力は LANG1 / LANG2 で切替。
 * トラックボールのスクロールレイヤー (layer 5) は
 * boards/shields/mona2/mona2_r.overlay の scroll_runtime_input_processor
 * (active-layers bitmask) で指定している。
 */

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&msc {
    delay-ms = <0>;
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        /* roBa の 34 + 40 に相当 (LANG2 キー + Backspace キー) */

        lang1 {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <33 39>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mt_slow: mt_slow {
            compatible = "zmk,behavior-hold-tap";
            label = "MOD_TAP_SLOW";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <300>;
            quick-tap-ms = <0>;
        };

        mt_fast: mt_fast {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_FAST";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <145>;
            quick-tap-ms = <0>;
        };

        // エンコーダ用 runtime-configurable sensor rotate
        // デフォルトは音量 (cw=C_VOL_UP, ccw=C_VOL_DN)
        // DYA Studio Web UI から レイヤーごとに cw/ccw の binding を
        // msc SCRL_UP/DOWN や kp LEFT/RIGHT などへ動的変更可能

        rsr_default: rsr_default {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <16>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "DEFAULT";
            bindings = <
&lt 8 Q                &kp W                    &kp E                     &kp R  &kp T                                                           &kp Y                 &kp U  &kp I                 &kp O                 &kp P
&mt_slow LEFT_SHIFT A  &kp S                    &kp D                     &kp F  &kp G                                &kp LG(PLUS)               &kp H                 &kp J  &kp K                 &kp L                 &kp MINUS
&kp Z                  &mt_slow LS(LEFT_ALT) X  &mt_slow LS(LEFT_META) C  &kp V  &kp B        &kp LEFT_BRACKET        &kp RIGHT_BRACKET          &kp N                 &kp M  &mt RIGHT_META COMMA  &mt RIGHT_ALT PERIOD  &mt_fast RCTRL SLASH
&lt 7 LANG2            &mo 6                    &mo 3                     &mo 1  &lt 2 SPACE  &lt_to_layer_0 5 TAB    &mt RIGHT_SHIFT BACKSPACE  &mt RIGHT_META ENTER                                                     &kp ESCAPE
            >;

            sensor-bindings = <&rsr_default>, <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_1 {
            display-name = "SYM";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH   &kp DOLLAR          &kp PERCENT                                     &kp AMPERSAND     &kp CARET          &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp PIPE         &kp GRAVE    &kp PLUS   &kp COLON           &kp EQUAL                      &kp LG(MINUS)    &kp LEFT_ARROW    &kp DOWN_ARROW     &kp UP_ARROW   &kp RIGHT_ARROW       &kp SEMICOLON
&kp BACKSLASH    &trans       &kp TILDE  &kp LS(UNDERSCORE)  &trans       &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp LESS_THAN  &kp GREATER_THAN      &kp QUESTION
&trans           &trans       &trans     &trans              &trans       &trans            &trans           &trans                                                                    &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        layer_2_mouse_click_and_func {
            display-name = "FUNC";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5                    &kp F6  &kp F7              &kp F8     &kp F9               &kp F10
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &mkp LCLK           &mkp RCLK  &mkp MCLK            &kp F11
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &kp LC(LEFT_ARROW)  &trans     &kp LC(RIGHT_ARROW)  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                                      &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        layer_3_text_select {
            display-name = "TXT_SEL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans                  &trans                  &trans                &trans             &trans
&trans  &trans  &trans  &trans  &trans            &trans  &kp LG(LS(LEFT_ARROW))  &kp LG(LS(DOWN_ARROW))  &kp LG(LS(UP_ARROW))  &kp LG(LS(RIGHT))  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp LG(LEFT)            &kp LG(DOWN)            &kp LG(UP)            &kp LG(RIGHT)      &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                                                                   &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        layer_4_mouse_layer {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans     &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &mkp LCLK  &mkp RCLK  &mkp MCLK  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans     &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                   &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        layer_5_mouse_layer {
            display-name = "NUM_SCRL";
            bindings = <
&trans  &trans                &trans         &trans  &trans                    &trans  &kp N7  &kp N8  &kp N9  &trans
&trans  &kp LS(LG(NUMBER_4))  &trans         &trans  &trans            &trans  &trans  &kp N4  &kp N5  &kp N6  &trans
&trans  &trans                &kp LS(LC(C))  &trans  &trans  &trans    &trans  &trans  &kp N1  &kp N2  &kp N3  &trans
&trans  &trans                &trans         &trans  &trans  &trans    &trans  &kp N0                          &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        layer_6 {
            display-name = "OPT_ARW";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans                  &trans                  &trans                &trans                   &trans
&trans  &trans  &trans  &trans  &trans            &trans  &kp LA(LS(LEFT_ARROW))  &kp LA(LS(DOWN_ARROW))  &kp LA(LS(UP_ARROW))  &kp LA(LS(RIGHT_ARROW))  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp LA(LEFT)            &kp LA(DOWN)            &kp LA(UP)            &kp LA(RIGHT)            &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                                                                         &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        layer_7_change_browser_tab {
            display-name = "TAB";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans            &kp LG(NUMBER_7)  &kp LG(NUMBER_8)  &kp LG(NUMBER_9)  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans            &kp LG(NUMBER_4)  &kp LG(NUMBER_5)  &kp LG(NUMBER_6)  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp LG(NUMBER_0)                                                        &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /* Q 長押しで入る。W の位置に &studio_unlock (DYA Studio のアンロック) */

        layer_8_move_window {
            display-name = "WIN_MGMT";
            bindings = <
&trans  &studio_unlock  &trans  &trans         &trans                                   &kp LS(LC(Y))      &trans         &trans         &kp LS(LC(O))    &kp LS(LC(P))
&trans  &trans          &trans  &kp LS(LC(F))  &trans            &trans                 &kp LS(LC(H))      &kp LS(LC(J))  &kp LS(LC(K))  &kp LC(LS(L))    &trans
&trans  &trans          &trans  &trans         &trans  &trans    &trans                 &kp LS(LC(N))      &trans         &trans         &kp LS(LC(DOT))  &trans
&trans  &trans          &trans  &trans         &trans  &trans    &kp LS(LC(BACKSPACE))  &kp LS(LC(ENTER))                                                 &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        layer_9 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
        };
    };
};
